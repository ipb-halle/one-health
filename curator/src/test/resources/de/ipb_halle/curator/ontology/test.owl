        <oboInOwl:hasOBONamespace>ncbi_taxonomy</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>all</oboInOwl:hasRelatedSynonym>
        <rdfs:label>root</rdfs:label>
