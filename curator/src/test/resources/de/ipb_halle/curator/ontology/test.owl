    <!-- http://purl.obolibrary.org/obo/NCBITaxon#_species_subgroup -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NCBITaxon#_species_subgroup">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon#_taxonomic_rank"/>
        <oboInOwl:hasOBONamespace>ncbi_taxonomy</oboInOwl:hasOBONamespace>
        <rdfs:label>species subgroup</rdfs:label>
    </owl:Class>



    <!-- http://purl.obolibrary.org/obo/NCBITaxon#_taxonomic_rank -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NCBITaxon#_taxonomic_rank">
        <oboInOwl:hasOBONamespace>ncbi_taxonomy</oboInOwl:hasOBONamespace>
        <rdfs:comment>This is an abstract class for use with the NCBI taxonomy to name the depth of the node within the tree. The link between the node term and the rank is only visible if you are using an obo 1.3 aware browser/editor; otherwise this can be ignored.</rdfs:comment>
        <rdfs:label>taxonomic rank</rdfs:label>
    </owl:Class>
</rdf:RDF>

