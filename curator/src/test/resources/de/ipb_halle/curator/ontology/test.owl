    <!-- http://purl.obolibrary.org/obo/ncbitaxon#has_rank -->

    <owl:AnnotationProperty rdf:about="http://purl.obolibrary.org/obo/ncbitaxon#has_rank">
        <obo:IAO_0000115>A metadata relation between a class and its taxonomic rank (eg species, family)</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>ncbi_taxonomy</oboInOwl:hasOBONamespace>
        <rdfs:comment>This is an abstract class for use with the NCBI taxonomy to name the depth of the node within the tree. The link between the node term and the rank is only visible if you are using an obo 1.3 aware browser/editor; otherwise this can be ignored</rdfs:comment>
        <rdfs:label>has_rank</rdfs:label>
    </owl:AnnotationProperty>



    <!-- http://purl.obolibrary.org/obo/ncbitaxon#in_part -->

